<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="@color/accent"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <TextView style="@style/Label" android:text="Gemini API Key (free)" />
        <EditText
            android:id="@+id/apiKeyInput"
            style="@style/Field"
            android:hint="Paste your free Gemini key"
            android:inputType="textNoSuggestions" />

        <TextView style="@style/Label" android:text="AI Model" />
        <EditText
            android:id="@+id/modelInput"
            style="@style/Field"
            android:hint="gemini-2.5-flash"
            android:inputType="textNoSuggestions" />

        <TextView style="@style/Label" android:text="Your Name" />
        <EditText
            android:id="@+id/nameInput"
            style="@style/Field"
            android:hint="What should Jarvis call you?"
            android:inputType="textCapWords" />

        <TextView style="@style/Label" android:text="Your City (for weather)" />
        <EditText
            android:id="@+id/cityInput"
            style="@style/Field"
            android:hint="e.g. Bengaluru"
            android:inputType="textCapWords" />

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#22FFFFFF" android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp" />

        <TextView style="@style/Label" android:text="SOS Trusted Contact Name" />
        <EditText
            android:id="@+id/sosNameInput"
            style="@style/Field"
            android:hint="e.g. Mom"
            android:inputType="textCapWords" />

        <TextView style="@style/Label" android:text="SOS Trusted Contact Number" />
        <EditText
            android:id="@+id/sosNumberInput"
            style="@style/Field"
            android:hint="e.g. +91XXXXXXXXXX"
            android:inputType="phone" />

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#22FFFFFF" android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Hands-free wake word (experimental)"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
            <Switch
                android:id="@+id/wakeSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView style="@style/Label" android:text="Wake phrase" />
        <EditText
            android:id="@+id/wakePhraseInput"
            style="@style/Field"
            android:hint="hey baby"
            android:inputType="text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="18dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Floating bubble on screen"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
            <Switch
                android:id="@+id/bubbleSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <Button
            android:id="@+id/saveBtn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:text="Save"
            android:textStyle="bold"
            android:backgroundTint="@color/accent"
            android:textColor="@color/bg" />

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#22FFFFFF" android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/versionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Version"
            android:textColor="@color/text_dim"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/updateBtn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Check for updates"
            android:textStyle="bold"
            android:backgroundTint="@color/bubble_user"
            android:textColor="@color/accent" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Get a free Gemini key at aistudio.google.com \u2192 Get API key. No credit card needed."
            android:textColor="@color/text_dim"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
